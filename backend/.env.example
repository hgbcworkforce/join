# Port to run the Express server
PORT=5000

# Supabase Credentials (Found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-or-anon-key

# JWT Secret for authenticating admin / team members
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS allowed origins (comma separated or specific domain)
CORS_ORIGIN=http://localhost:5173,https://join.hgbcinfluencers.org,https://hgbcinfluencers.org
